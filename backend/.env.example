# ============================================
# Environment Configuration for Agente AI Backend
# ============================================

# Required: LLM provider for the 12-agent pipeline. Gemini is used first;
# Groq is a fallback if Gemini's call fails for any reason (missing/invalid
# key, rate limit, request error). Both expose an OpenAI-compatible
# /chat/completions endpoint (see backend/autogen_runtime.py).
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# Supabase
# ============================================
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key (Project Settings > API). Bypasses RLS -- backend-only,
# never exposed to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Legacy JWT Secret (Project Settings > API). Used to verify the bearer
# tokens Supabase Auth issues to the frontend. Anyone with this secret can
# forge a valid token for any user -- backend-only, never commit it.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ============================================
# Server Configuration
# ============================================
# PORT=8000
# HOST=0.0.0.0
# Comma-separated list of allowed frontend origins for CORS in production.
# Defaults to http://localhost:8080 (the frontend's Vite dev port) if unset.
# CORS_ALLOWED_ORIGINS=https://app.example.com
