# ============================================
# Environment Configuration for ArthaSetu Frontend
# ============================================
# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API). The anon key is safe to expose in the client
# bundle -- it relies on RLS (see supabase/migrations/) to enforce
# per-user access, not secrecy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API (only needed for triggering agent analysis runs)
VITE_API_BASE_URL=http://localhost:8000/api
